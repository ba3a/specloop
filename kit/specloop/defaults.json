{
  "commandPrefix": "sl-",
  "initialPhase": "plan",
  "maxIterations": 15,
  "checkTimeoutSec": 900,
  "maxOutputChars": 4000,
  "shell": "bash",
  "blockedCommandsUntilDone": ["git push", "gh pr create", "gh pr merge"],
  "largeSpecWarning": { "maxLines": 200, "maxWords": 2000, "maxPlanItems": 12 },
  "feature": {
    "branchPrefix": "specloop/",
    "planPhase": "feature-plan",
    "requirePlanApproval": true,
    "gitTimeoutSec": 60,
    "planPhases": {
      "feature-plan": {
        "delegate": true,
        "allowEdits": [".claude/specloop/run/"],
        "check": { "type": "steps", "path": ".claude/specloop/run/steps.json", "requireAllPending": true }
      },
      "feature-replan": {
        "delegate": true,
        "allowEdits": [".claude/specloop/run/"],
        "check": { "type": "steps", "path": ".claude/specloop/run/steps.json", "requireAllPending": false }
      }
    },
    "replan": "stall",
    "replanPhase": "feature-replan",
    "maxReplans": 3,
    "stepInitialPhase": "implement",
    "stepPhases": {
      "implement": {
        "delegate": true,
        "next": "review",
        "check": null
      },
      "review": {
        "delegate": true,
        "next": "commit",
        "allowEdits": [".claude/specloop/run/"],
        "check": {
          "type": "verdict",
          "path": "{attempt_dir}/review.md",
          "approve": "VERDICT: APPROVE",
          "reject": "VERDICT: CHANGES_REQUESTED",
          "onReject": "implement"
        }
      }
    },
    "commitExclude": [".claude/specloop/"],
    "commitMessage": "{type}: {step_title}\n\nspecloop step {step_index}/{step_count} ({step_id}) of {spec}",
    "pauseBetweenSteps": false,
    "enforceDelegation": false,
    "blockedCommands": ["git commit", "git checkout", "git switch", "git reset", "git rebase", "git merge",
                        "git stash", "git branch -D", "git push"]
  },
  "phases": {
    "plan": {
      "next": "implement",
      "allowEdits": [".claude/specloop/run/"],
      "check": { "type": "file", "path": ".claude/specloop/run/plan.md" }
    },
    "implement": {
      "next": "review",
      "check": null
    },
    "review": {
      "next": "done",
      "allowEdits": [".claude/specloop/run/"],
      "check": {
        "type": "verdict",
        "path": "{attempt_dir}/review.md",
        "approve": "VERDICT: APPROVE",
        "reject": "VERDICT: CHANGES_REQUESTED",
        "onReject": "implement"
      }
    }
  }
}
